---
// Representación genérica de la pasarela externa. NO replica la interfaz real de Wompi:
// es un marcador para mostrar que el cliente sale del sitio un momento (Definición del proyecto, sección 5).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getImagen } from '../../data/imagenes';
const wompi = getImagen('logo-wompi');
---
<Base title="Pasarela de pago (simulada)" variant="external">
  <div class="gw">
    <div class="urlbar"><Icon name="lock" size={14} /> <span>Página de pago de Wompi</span> <span class="tbd">Simulación</span></div>

    <div class="gw-card">
      <header class="gw-head">
        <span class={`gw-logo${wompi ? ' has-logo' : ''}`}><span class="logo-text">Logo Wompi</span>{wompi && <img class="logo-img" src={wompi.file} alt={wompi.alt} />}</span>
        <div><small>Pagas a</small><b>Game Corner Store</b></div>
        <div class="gw-amount"><small>Total</small><b data-total>$22.00</b></div>
      </header>

      <form class="gw-form" onsubmit="return false">
        <div class="field"><label for="cc">Número de tarjeta</label><input class="input" id="cc" inputmode="numeric" placeholder="0000 0000 0000 0000" /></div>
        <div class="row">
          <div class="field"><label for="exp">Vence</label><input class="input" id="exp" placeholder="MM/AA" /></div>
          <div class="field"><label for="cvc">CVC</label><input class="input" id="cvc" inputmode="numeric" placeholder="123" /></div>
        </div>
        <div class="field"><label for="holder">Nombre en la tarjeta</label><input class="input" id="holder" placeholder="Como aparece en la tarjeta" /></div>
        <p class="small muted secure-note"><Icon name="shield" size={16} /> Tu banco puede pedirte una verificación adicional (3-D Secure).</p>
      </form>

      <div class="sim">
        <p class="small"><b>Controles del prototipo</b> · elige el resultado del pago:</p>
        <a class="btn btn-primary btn-block" href="/pedido/confirmado/">Simular pago aprobado</a>
        <a class="btn btn-secondary btn-block" href="/pedido/rechazado/">Simular pago rechazado</a>
      </div>

      <a class="cancel small" href="/checkout/"><Icon name="back" size={14} /> Cancelar y volver a Game Corner Store</a>
    </div>
  </div>
</Base>

<script>
  import { getOrderItems, lines, totals, usd } from '../../scripts/cart';
  const el = document.querySelector('[data-total]');
  if (el) el.textContent = usd(totals(lines(getOrderItems())).total);
</script>

<style>
  :global(body.v-external) { background: #E9EBEF; }
  .gw { max-width: 460px; margin: 0 auto; padding: var(--s-5) var(--gutter) var(--s-8); font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; }
  .urlbar { display: flex; align-items: center; gap: 8px; justify-content: center; font-size: var(--t-xs); color: #3B4150; margin-bottom: var(--s-4); }
  .gw-card { background: #fff; border-radius: 12px; padding: var(--s-5); box-shadow: 0 10px 30px -15px rgba(0,0,0,.3); display: grid; gap: var(--s-5); }
  .gw-head { display: grid; grid-template-columns: auto 1fr auto; gap: var(--s-3); align-items: center; padding-bottom: var(--s-4); border-bottom: 1px solid #E3E5EA; }
  .gw-head small { display: block; font-size: var(--t-xs); color: #6B7280; }
  .gw-logo { display: grid; place-items: center; width: 56px; height: 40px; border: 1.5px dashed #9CA3AF; border-radius: 6px; font-size: 0.625rem; color: #6B7280; text-align: center; }
  .gw-amount { text-align: right; }
  .gw-amount b { font-size: var(--t-lg); }
  .gw-form { display: grid; gap: var(--s-4); }
  .gw-form .input { border: 1px solid #C9CDD5; border-radius: 8px; }
  .gw-form label { font-weight: 600; font-size: var(--t-sm); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
  .secure-note { display: flex; gap: 6px; align-items: center; margin: 0; }
  .sim { display: grid; gap: var(--s-2); padding: var(--s-4); border: 2px dashed var(--c-muted); background: var(--c-paper); }
  .sim p { margin: 0 0 4px; }
  .cancel { display: inline-flex; align-items: center; gap: 4px; justify-self: center; color: #3B4150; }
</style>
