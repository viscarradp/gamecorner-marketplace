---
interface Swatch { name: string; hex: string; role: string }
interface Props {
  id: string;
  letter: string;
  name: string;
  concept: string;
  attributes: string[];
  rationale: string;
  fonts: { display: string; body: string; extra?: string };
  swatches: Swatch[];
  voice: { label: string; text: string }[];
  risk: string;
}
const { id, letter, name, concept, attributes, rationale, fonts, swatches, voice, risk } = Astro.props;
---
<section class={`dir ${id}`} id={id} aria-labelledby={`${id}-title`}>
  <header class="dir-head">
    <p class="dir-letter">Dirección {letter}</p>
    <h2 id={`${id}-title`} class="dir-name">{name}</h2>
    <p class="dir-concept">{concept}</p>
    <ul class="dir-attrs">{attributes.map((a) => <li>{a}</li>)}</ul>
  </header>

  <div class="dir-grid">
    <!-- Columna 1: sistema -->
    <div class="dir-system">
      <h3 class="dir-h3">Color</h3>
      <ul class="swatches">
        {swatches.map((s) => (
          <li>
            <span class="chip" style={`background:${s.hex}`}></span>
            <span class="sw-name">{s.name}</span>
            <code class="sw-hex">{s.hex}</code>
            <span class="sw-role">{s.role}</span>
          </li>
        ))}
      </ul>

      <h3 class="dir-h3">Tipografía</h3>
      <div class="type-spec">
        <p class="t-display">Recargas, juegos y consolas con precio final.</p>
        <p class="t-body">Pagas con tu tarjeta de débito local a través de Wompi. Te avisamos por WhatsApp cuando tu pedido va en camino.</p>
        <p class="t-meta">{fonts.display} · {fonts.body}{fonts.extra ? ` · ${fonts.extra}` : ''}</p>
      </div>

      <h3 class="dir-h3">Tono de voz</h3>
      <dl class="voice">
        {voice.map((v) => (<div><dt>{v.label}</dt><dd>“{v.text}”</dd></div>))}
      </dl>
    </div>

    <!-- Columna 2: muestra en móvil -->
    <div class="phone" aria-label={`Muestra móvil, dirección ${letter}`}>
      <div class="phone-screen">
        <div class="m-header">
          <span class="logo">Game<b>Corner</b></span>
          <span class="m-icons" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            <span class="cart"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h2l2.4 11h11L21 7H6.2"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg><i>1</i></span>
          </span>
        </div>
        <div class="m-crumbs">Inicio › Códigos y saldo › PlayStation</div>

        <article class="card">
          <div class="card-img"><span>Imagen tarjeta PSN</span></div>
          <div class="card-body">
            <p class="tag">Código digital · Cuenta de EE. UU.</p>
            <h4 class="card-title">Tarjeta PlayStation Network</h4>
            <div class="amounts" role="radiogroup" aria-label="Monto">
              <span>$10</span><span class="on">$20</span><span>$50</span>
            </div>
            <p class="price"><span class="price-num">$22.00</span> <span class="price-note">precio final, sin cargos extra</span></p>
            <a class="btn" href="#">Agregar al carrito</a>
            <p class="badge"><span class="badge-ico" aria-hidden="true">◷</span> <span>Recibes tu código en <b>hasta 24 h</b> por WhatsApp o correo</span></p>
            <div class="pay">
              <span class="pay-label">Paga seguro con</span>
              <span class="pay-logo">Wompi</span>
              <span class="pay-logo">Banco Agrícola</span>
            </div>
          </div>
        </article>

        <div class="alert">
          <b>¿No funciona tu código?</b> Te lo reponemos. Escríbenos por WhatsApp.
        </div>
      </div>
      <a class="wa" href="#" aria-label="WhatsApp">WhatsApp</a>
    </div>
  </div>

  <footer class="dir-foot">
    <p><b>Por qué encaja:</b> {rationale}</p>
    <p><b>Riesgo a vigilar:</b> {risk}</p>
  </footer>
</section>

<style>
  .dir {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--f-body);
    padding: clamp(24px, 5vw, 56px) 16px;
    border-top: 1px solid rgba(0,0,0,.08);
  }
  .dir > * { max-width: 1120px; margin-inline: auto; }
  .dir-letter { font: 600 .8rem/1 var(--f-body); letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  .dir-name { font-family: var(--f-display); font-weight: var(--w-display); font-size: clamp(2rem, 6vw, 3.4rem); line-height: 1; margin: 0 0 12px; letter-spacing: var(--ls-display, -0.02em); }
  .dir-concept { font-size: 1.05rem; max-width: 60ch; margin: 0 0 16px; }
  .dir-attrs { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0 0 32px; }
  .dir-attrs li { border: 1.5px solid var(--ink); padding: 4px 10px; border-radius: var(--r-pill); font-size: .85rem; font-weight: 600; }

  .dir-grid { display: grid; gap: 40px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .dir-grid { grid-template-columns: 1fr 380px; align-items: start; } }

  .dir-h3 { font-family: var(--f-display); font-weight: var(--w-display); font-size: 1.15rem; margin: 28px 0 12px; }
  .dir-h3:first-child { margin-top: 0; }
  .swatches { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .swatches li { display: grid; grid-template-columns: 40px 1fr; column-gap: 10px; align-items: center; font-size: .8rem; }
  .chip { grid-row: span 3; width: 40px; height: 52px; border-radius: var(--r-sm); border: 1px solid rgba(0,0,0,.15); }
  .sw-name { font-weight: 700; }
  .sw-hex { font-family: ui-monospace, monospace; font-size: .75rem; color: var(--muted); }
  .sw-role { color: var(--muted); font-size: .75rem; }

  .type-spec { border-left: 3px solid var(--primary); padding-left: 16px; }
  .t-display { font-family: var(--f-display); font-weight: var(--w-display); font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.08; margin: 0 0 12px; letter-spacing: var(--ls-display, -0.02em); }
  .t-body { margin: 0 0 8px; max-width: 52ch; line-height: 1.55; }
  .t-meta { font-size: .78rem; color: var(--muted); margin: 0; }

  .voice { margin: 0; display: grid; gap: 10px; }
  .voice div { display: grid; gap: 2px; }
  .voice dt { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; }
  .voice dd { margin: 0; }

  /* Teléfono */
  .phone { position: relative; width: 100%; max-width: 360px; margin-inline: auto; border: 10px solid #1a1a1a; border-radius: 36px; overflow: hidden; background: var(--surface-page); box-shadow: 0 20px 40px -20px rgba(0,0,0,.35); }
  .phone-screen { padding: 0 0 80px; min-height: 640px; }
  .m-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; background: var(--header-bg); color: var(--header-ink); }
  .logo { font-family: var(--f-display); font-weight: var(--w-display); font-size: 1.15rem; letter-spacing: -0.01em; }
  .logo b { color: var(--logo-accent); font-weight: inherit; }
  .m-icons { display: flex; gap: 14px; font-size: 1.1rem; }
  .cart { position: relative; }
  .cart i { position: absolute; top: -6px; right: -8px; background: var(--accent); color: var(--on-accent); font: 700 .6rem/1 var(--f-body); font-style: normal; padding: 3px 5px; border-radius: 99px; }
  .m-crumbs { font-size: .72rem; color: var(--muted); padding: 10px 16px; }

  .card { margin: 0 16px; background: var(--surface); border: var(--card-border); border-radius: var(--r-card); box-shadow: var(--card-shadow); overflow: hidden; clip-path: var(--card-clip, none); }
  .card-img { aspect-ratio: 16/9; background: repeating-linear-gradient(45deg, var(--ph-a) 0 10px, var(--ph-b) 10px 20px); display: grid; place-items: center; font-size: .75rem; color: var(--muted); }
  .card-img span { background: var(--surface); padding: 4px 8px; border-radius: 4px; }
  .card-body { padding: 16px; }
  .tag { font-family: var(--f-tag, var(--f-body)); font-size: var(--tag-size, .72rem); text-transform: uppercase; letter-spacing: .06em; color: var(--secondary); margin: 0 0 6px; font-weight: 600; }
  .card-title { font-family: var(--f-display); font-weight: var(--w-display); font-size: 1.3rem; margin: 0 0 12px; line-height: 1.1; }
  .amounts { display: flex; gap: 8px; margin-bottom: 14px; }
  .amounts span { flex: 1; text-align: center; padding: 10px 0; border: 1.5px solid var(--line); border-radius: var(--r-sm); font-weight: 600; }
  .amounts .on { border-color: var(--primary); background: var(--primary-soft); color: var(--primary-ink); box-shadow: inset 0 0 0 1px var(--primary); }
  .price { margin: 0 0 14px; display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .price-num { font-family: var(--f-price, var(--f-display)); font-weight: 800; font-size: 1.9rem; letter-spacing: -0.02em; }
  .price-note { font-size: .78rem; color: var(--muted); }
  .btn { display: block; text-align: center; background: var(--primary); color: var(--on-primary); font-weight: 700; padding: 14px; border-radius: var(--r-btn); text-decoration: none; border: var(--btn-border, 0); box-shadow: var(--btn-shadow, none); }
  .badge { display: flex; gap: 8px; align-items: center; margin: 10px 0 14px; padding: 10px 12px; background: var(--badge-bg); color: var(--badge-ink); border-radius: var(--r-sm); font-size: .82rem; line-height: 1.3; }
  .badge-ico { font-size: 1.1rem; }
  .pay { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: .72rem; color: var(--muted); }
  .pay-logo { border: 1px dashed var(--line); padding: 4px 8px; border-radius: 4px; color: var(--ink); font-weight: 600; }
  .alert { margin: 16px; padding: 12px 14px; border-left: 4px solid var(--secondary); background: var(--surface); font-size: .85rem; border-radius: var(--r-sm); }
  .wa { position: absolute; right: 14px; bottom: 14px; background: #1f8f4e; color: #fff; font-weight: 700; font-size: .8rem; padding: 12px 16px; border-radius: 99px; text-decoration: none; box-shadow: 0 6px 16px -6px rgba(0,0,0,.4); }

  .dir-foot { margin-top: 32px; display: grid; gap: 8px; font-size: .95rem; }
  .dir-foot p { margin: 0; max-width: 80ch; }

  /* ——— Dirección A: Mostrador ——— */
  .dir-a {
    --bg: #F4EEE3; --surface: #FFFDF8; --surface-page: #F4EEE3; --ink: #1D1B18; --muted: #6B645A; --line: #CFC5B4;
    --primary: #D9481F; --on-primary: #FFFFFF; --primary-soft: #FBE3D9; --primary-ink: #8A2A0F;
    --secondary: #1F5A48; --accent: #D9481F; --on-accent: #fff;
    --header-bg: #1D1B18; --header-ink: #F4EEE3; --logo-accent: #F07A4E;
    --badge-bg: #E2EFE8; --badge-ink: #1F5A48;
    --ph-a: #EAE1D1; --ph-b: #F1EADF;
    --f-display: 'Bricolage Grotesque', system-ui, sans-serif; --w-display: 800; --f-body: 'Public Sans', system-ui, sans-serif;
    --r-sm: 6px; --r-btn: 6px; --r-card: 0; --r-pill: 4px;
    --card-border: 1px solid #CFC5B4; --card-shadow: none;
    --card-clip: polygon(0 0, calc(100% - 22px) 0, 100% 22px, 100% 100%, 0 100%);
  }
  /* ——— Dirección B: Cartucho ——— */
  .dir-b {
    --bg: #FFFFFF; --surface: #FFFFFF; --surface-page: #F2F2EE; --ink: #0E0E10; --muted: #5C5C63; --line: #0E0E10;
    --primary: #0E0E10; --on-primary: #FFD23F; --primary-soft: #FFF3C4; --primary-ink: #0E0E10;
    --secondary: #2949E6; --accent: #FFD23F; --on-accent: #0E0E10;
    --header-bg: #FFD23F; --header-ink: #0E0E10; --logo-accent: #2949E6;
    --badge-bg: #0E0E10; --badge-ink: #FFD23F;
    --ph-a: #E7E7E2; --ph-b: #F2F2EE;
    --f-display: 'Archivo', system-ui, sans-serif; --w-display: 800; --f-body: 'IBM Plex Sans', system-ui, sans-serif;
    --f-tag: 'Silkscreen', monospace; --tag-size: .68rem;
    --r-sm: 0; --r-btn: 0; --r-card: 0; --r-pill: 0;
    --card-border: 2px solid #0E0E10; --card-shadow: 6px 6px 0 #0E0E10;
    --btn-shadow: 4px 4px 0 #2949E6;
    --ls-display: -0.03em;
  }
  .dir-b .card { margin-right: 22px; }
  /* ——— Dirección C: Azul cuscatleco ——— */
  .dir-c {
    --bg: #F5F7FB; --surface: #FFFFFF; --surface-page: #F5F7FB; --ink: #0F1B33; --muted: #5A6681; --line: #D5DCEA;
    --primary: #0F47AF; --on-primary: #FFFFFF; --primary-soft: #E6EEFB; --primary-ink: #0B3683;
    --secondary: #0F47AF; --accent: #F2B705; --on-accent: #0F1B33;
    --header-bg: #FFFFFF; --header-ink: #0F1B33; --logo-accent: #0F47AF;
    --badge-bg: #FFF6D6; --badge-ink: #5B4500;
    --ph-a: #E9EEF7; --ph-b: #F3F6FB;
    --f-display: 'Manrope', system-ui, sans-serif; --w-display: 800; --f-body: 'Manrope', system-ui, sans-serif;
    --f-price: 'JetBrains Mono', ui-monospace, monospace;
    --r-sm: 10px; --r-btn: 12px; --r-card: 16px; --r-pill: 99px;
    --card-border: 1px solid #D5DCEA; --card-shadow: 0 8px 24px -16px rgba(15,27,51,.35);
  }
  .dir-c .m-header { border-bottom: 1px solid var(--line); }
</style>
